# Copy these into your host's "Environment" screen (Render / Railway / Fly). Never commit real values.
NODE_ENV=production

# --- URLs (no trailing slash, must be https) ---
PUBLIC_API_URL=https://govdocs-api.onrender.com
FRONTEND_URL=https://govdocs-ai.vercel.app
CORS_ORIGIN=https://govdocs-ai.vercel.app

# --- Database (Supabase / Neon / any PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL=true

# --- Login (Clerk) ---
CLERK_SECRET_KEY=sk_live_or_test_...

# --- Encryption: generate with `node scripts/gen-key.js`. BACK IT UP. ---
ENCRYPTION_KEY=

# --- File storage (S3 or Cloudflare R2) ---
AWS_S3_BUCKET=govdocs-files
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cloudflare R2 only:
# AWS_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- Optional ---
MAX_FILE_MB=25
GEMINI_API_KEY=
AI_IMAGES=false
OCR_LANGS=eng
