# ---------- Server ----------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ---------- Database ----------
# Zero-setup mode (default): local file database, nothing to install.
# For PostgreSQL (Supabase / docker-compose / any Postgres) set DATABASE_URL:
# DATABASE_URL=postgresql://govdocs:govdocs123@localhost:5432/govdocs
# DB_SSL=true

# ---------- Auth (Clerk) ----------
# Empty = local single-user "dev mode" (no login). REQUIRED in production.
CLERK_SECRET_KEY=

# ---------- Encryption ----------
# AES-256-GCM master key. Production: long random string (32+ chars).
# Dev: auto-generated into data/.devkey if empty.
# KEEP IT SAFE - if lost, stored files cannot be decrypted.
ENCRYPTION_KEY=

# ---------- File storage ----------
# Default: encrypted files on local disk (data/storage).
# Set AWS_S3_BUCKET to store in S3 instead (AWS creds via standard env vars).
STORAGE_DIR=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
# Cloudflare R2 / other S3-compatible store: set the endpoint and use AWS_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ---------- Limits ----------
MAX_FILE_MB=100
TEMP_TTL_MINUTES=60

# ---------- AI (optional) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Send vault images to Gemini for document-type + face detection? (default off, privacy-first)
AI_IMAGES=false

# ---------- OCR ----------
OCR_LANGS=eng
